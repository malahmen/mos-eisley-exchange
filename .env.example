# Copy to .env and adjust. Real environment variables win over this file.

# --- Server
PORT=3000
# HOST=0.0.0.0
# Idle session timeout, and the hard maximum for any session.
SESSION_TTL_HOURS=12
SESSION_MAX_DAYS=7
# Set to true once the site is served over HTTPS (adds the Secure cookie flag).
COOKIE_SECURE=false
# Set to true only behind a reverse proxy you control (reads X-Forwarded-For / X-Forwarded-Host).
TRUST_PROXY=false
# Encrypts stored secrets (provider API keys, SMTP password, two-factor secrets).
# Generate with: npm run gen-secret. Keep it safe: without it those secrets cannot be read.
# When rotating, put the previous value in SECRET_KEY_OLD for one restart.
# SECRET_KEY=
# SECRET_KEY_OLD=
# Admin pages only from these networks (IPv4/IPv6 CIDR, comma-separated). Empty = any.
# ADMIN_ALLOW_CIDRS=192.168.1.0/24

# --- Database: sqlite (a local file, default) or mysql
DB_ENGINE=sqlite
SQLITE_PATH=data/exchange.sqlite
# DB_ENGINE=mysql
# MYSQL_HOST=192.168.1.10
# MYSQL_PORT=3306
# MYSQL_USER=exchange
# MYSQL_PASSWORD=change-me
# MYSQL_DATABASE=exchange

# --- First admin (optional). When no users exist, this account is created at startup.
# Without it, the site shows a one-time setup page instead. Remove after the first start.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=a-long-passphrase

# --- Market data API keys (all optional). The free, keyless sources work without any of these.
# They can also be entered in Admin → Providers; a key set here wins.
# FINNHUB_API_KEY=
# TWELVEDATA_API_KEY=
# ALPHAVANTAGE_API_KEY=
# COINGECKO_DEMO_API_KEY=

# --- LLM for the optional market brief (off by default). Same variables as death-star-audit.
LLM_ENABLED=false
# "anthropic": the Messages API (Anthropic, or a gateway speaking it). Needs `npm install` (optional SDK).
# "openai":    an OpenAI-compatible /chat/completions server: LM Studio, llama.cpp, vLLM, Ollama (/v1).
LLM_API=anthropic
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# LLM_API_KEY=            # falls back to ANTHROPIC_API_KEY for LLM_API=anthropic
# LLM_BASE_URL=           # default: https://api.anthropic.com
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=180
# Example, LM Studio on the LAN:
# LLM_ENABLED=true
# LLM_API=openai
# LLM_BASE_URL=http://192.168.1.20:1234/v1
# LLM_MODEL=qwen/qwen3.6-35b-a3b
